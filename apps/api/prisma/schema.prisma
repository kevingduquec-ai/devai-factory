generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  owner
  admin
  member
}

enum UserStatus {
  invited
  active
}

enum SubscriptionPlan {
  starter
  team
  empresa
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
}

enum ProjectStatus {
  intake
  ready_to_generate
  generating
  generated
  failed
}

enum RequirementPriority {
  must
  should
  could
  wont
}

enum RequirementType {
  functional
  non_functional
}

enum RequirementStatus {
  draft
  approved
  implemented
  obsolete
}

enum TestCaseType {
  functional
  negative
  security
  integration
  regression
  performance
}

enum TestCaseStatus {
  not_executed
  passed
  failed
  blocked
}

enum TestCaseSeverity {
  alta
  media
  baja
}

enum ExportFormat {
  pdf
  docx
}

enum IntegrationProvider {
  jira
  clickup
}

enum IntegrationConnectionStatus {
  active
  expired
  revoked
}

enum SyncStatus {
  in_progress
  completed
  completed_with_errors
  failed
}

enum SyncSourceType {
  full_study
  single_story
}

enum SyncItemType {
  epic
  user_story
  test_case
}

enum SyncItemStatus {
  created
  failed
}

model Organization {
  id               String   @id @default(uuid())
  name             String
  plan             SubscriptionPlan @default(starter)
  billingCustomerId String? @map("billing_customer_id")
  // Cuando está en true, ningún usuario de esta organización puede iniciar
  // sesión ni mantener una sesión activa — se verifica en login, en
  // refresh, y en cada request autenticado (JwtStrategy.validate), así que
  // el bloqueo aplica incluso a un access token ya emitido, no solo a
  // logins nuevos. Es independiente del campo `plan`: suspende el acceso
  // sin perder el historial de qué plan tenía contratado.
  suspended        Boolean  @default(false)
  // Falso por defecto para toda organización nueva — un registro nunca
  // desbloquea el producto por sí solo. Se vuelve true por dos caminos
  // únicamente: (1) el webhook de Stripe confirma una suscripción pagada
  // (BillingService.applySubscription), o (2) el super-admin la activa
  // manualmente desde el panel. Mientras esté en false, el frontend confina
  // a todos los usuarios de la organización a /dashboard/billing, y el
  // backend rechaza crear o generar proyectos (ver ProjectsService).
  subscriptionActive Boolean @default(false) @map("subscription_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  users         User[]
  projects      Project[]
  subscriptions Subscription[]
  usageEvents   UsageEvent[]
  generationRuns GenerationRun[]
  supportMessages SupportMessage[]
  supportConversation SupportConversation?
  integrationConnections IntegrationConnection[]
  syncRuns      SyncRun[]
  qaTestModules QaTestModule[]
  qaTestRuns    QaTestRun[]

  @@map("organizations")
}

// Cuenta de plataforma, deliberadamente fuera del modelo de organizaciones
// (no es un User ni tiene orgId) — ve y administra todas las
// organizaciones clientes de Qubit. Nunca se expone un registro público
// para este modelo; las cuentas se crean directamente en la base de datos.
model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_admins")
}

model User {
  id           String     @id @default(uuid())
  orgId        String     @map("org_id")
  email        String     @unique
  name         String
  role         OrgRole    @default(member)
  status       UserStatus @default(active)
  passwordHash String?    @map("password_hash")
  // El módulo "Historia de usuario" (título + descripción -> una sola
  // historia) está disponible por defecto para todos los planes y todos los
  // usuarios — el super-admin es el único que puede desactivarlo, y lo hace
  // persona por persona, no por organización. Ver ProjectsService.
  singleStoryEnabled Boolean @default(true) @map("single_story_enabled")
  // Módulo add-on "Creación automática en Jira/ClickUp" — al revés del
  // anterior, arranca desactivado: es un servicio adicional que el
  // super-admin enciende persona por persona (piloto, upventa manual,
  // revocar por impago), nunca un beneficio automático del plan. Ver
  // IntegrationsService.assertIntegrationsEnabled.
  integrationsEnabled Boolean @default(false) @map("integrations_enabled")
  // Módulo add-on "QA-AI: automatización de pruebas web" — mismo patrón que
  // integrationsEnabled: arranca desactivado, el super-admin lo activa
  // persona por persona. Ver QaService.assertQaAutomationEnabled.
  qaAutomationEnabled Boolean @default(false) @map("qa_automation_enabled")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectsCreated Project[]    @relation("ProjectCreatedBy")
  supportMessagesSent SupportMessage[]

  @@index([orgId])
  @@map("users")
}

// Chat de soporte — un hilo compartido por organización (cualquier persona
// del equipo ve y puede escribir en el mismo hilo, sin importar su rol ni
// el plan de la organización). Del otro lado, solo el super-admin puede
// responder, nunca otro usuario de otra organización — por eso el lado
// admin necesita leer y escribir en el hilo de cualquier organización
// mediante bypassRls(), aunque el hilo en sí sigue protegido por RLS para
// el lado de la organización.
model SupportMessage {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  // Quién envió el mensaje: un usuario de la organización (senderUserId),
  // o el super-admin (senderIsAdmin = true, senderUserId queda null).
  senderUserId  String?  @map("sender_user_id")
  senderIsAdmin Boolean  @default(false) @map("sender_is_admin")
  body          String
  // Vistos aparte para cada lado: readByOrg solo aplica a mensajes del
  // admin (¿ya lo vio alguien de la organización?), readByAdmin solo a
  // mensajes de la organización (¿ya lo vio el super-admin?) — así cada
  // lado tiene su propio contador de no leídos.
  readByOrg     Boolean  @default(false) @map("read_by_org")
  readByAdmin   Boolean  @default(false) @map("read_by_admin")
  createdAt     DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  senderUser   User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@map("support_messages")
}

// Estado de "cerrada / abierta" del hilo de soporte de una organización.
// Fila separada de SupportMessage a propósito: así no hace falta tocar los
// mensajes existentes, y una organización sin fila acá se trata como
// abierta por defecto. Solo el super-admin puede cerrarla — si la
// organización vuelve a escribir en un hilo cerrado, se reabre sola (ver
// SupportService.sendMessage), pero nunca por una acción explícita de
// "reabrir" del lado de la organización, que no existe.
model SupportConversation {
  orgId     String    @id @map("org_id")
  closed    Boolean   @default(false)
  closedAt  DateTime? @map("closed_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("support_conversations")
}

model Project {
  id        String        @id @default(uuid())
  orgId     String        @map("org_id")
  name      String
  domain    String?
  status    ProjectStatus @default(intake)
  // true = creado desde el módulo "Historia de usuario" (ProjectsService.
  // createQuickStory), false = creado desde el módulo "Análisis completo"
  // (ProjectsService.create). Son dos flujos de creación separados, nunca
  // una elección dentro del mismo formulario — este campo solo registra por
  // cuál de los dos pasó el proyecto. Queda fijo de por vida, incluida
  // cualquier regeneración futura.
  storiesOnly Boolean      @default(false) @map("stories_only")
  createdBy String        @map("created_by")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator              User                @relation("ProjectCreatedBy", fields: [createdBy], references: [id])
  intakeSessions       IntakeSession[]
  requirements         Requirement[]
  dataModelEntities    DataModelEntity[]
  apiEndpoints         ApiEndpoint[]
  testCases            TestCase[]
  documentsExported    DocumentExported[]
  usageEvents          UsageEvent[]
  generationRuns       GenerationRun[]
  syncRuns             SyncRun[]

  @@index([orgId])
  @@map("projects")
}

model IntakeSession {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  messages  Json     @default("[]")
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("intake_sessions")
}

model Requirement {
  id          String              @id @default(uuid())
  projectId   String              @map("project_id")
  code        String
  title       String
  description String
  type        RequirementType     @default(functional)
  priority    RequirementPriority @default(should)
  actor       String?             @map("actor")
  // Criterios de aceptación propios del requerimiento (Dado/Cuando/Entonces,
  // sin nombre de escenario) — distintos de los criterios Gherkin, con
  // nombre de escenario, que viven en cada historia de usuario.
  acceptanceCriteria Json          @default("[]") @map("acceptance_criteria")
  businessRules      String?       @map("business_rules")
  dependencies       String?
  assumptions        String?
  status             RequirementStatus @default(draft)
  version            String        @default("1.0")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userStories UserStory[]

  @@index([projectId])
  @@unique([projectId, code])
  @@map("requirements")
}

model UserStory {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  requirementId String   @map("requirement_id")
  code          String
  title         String
  actor         String
  goal          String
  benefit       String
  priority      RequirementPriority? @map("priority")
  storyPoints   Int?     @map("story_points")
  dependencies  String?
  definitionOfReady String? @map("definition_of_ready")
  definitionOfDone  String? @map("definition_of_done")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  requirement        Requirement        @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  acceptanceCriteria AcceptanceCriterion[]

  @@index([requirementId])
  @@unique([projectId, code])
  @@map("user_stories")
}

model AcceptanceCriterion {
  id           String   @id @default(uuid())
  userStoryId  String   @map("user_story_id")
  scenarioName String   @map("scenario_name")
  given        String
  when         String
  then         String
  createdAt    DateTime @default(now()) @map("created_at")

  userStory UserStory  @relation(fields: [userStoryId], references: [id], onDelete: Cascade)
  testCases TestCase[]

  @@index([userStoryId])
  @@map("acceptance_criteria")
}

model DataModelEntity {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  fields    Json     @default("[]")
  relations Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("data_model_entities")
}

model ApiEndpoint {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  method          String
  path            String
  description     String
  requestSchema   Json?    @map("request_schema")
  responseSchema  Json?    @map("response_schema")
  createdAt       DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("api_endpoints")
}

model TestCase {
  id                    String       @id @default(uuid())
  projectId             String       @map("project_id")
  acceptanceCriteriaId  String       @map("acceptance_criteria_id")
  code                  String
  title                 String
  type                  TestCaseType
  precondition          String       @default("")
  steps                 Json         @default("[]")
  testData              String?      @map("test_data")
  expectedResult        String       @map("expected_result")
  actualResult          String?      @map("actual_result")
  status                TestCaseStatus    @default(not_executed)
  severity              TestCaseSeverity  @default(media)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  acceptanceCriterion AcceptanceCriterion  @relation(fields: [acceptanceCriteriaId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@unique([projectId, code])
  @@map("test_cases")
}

model DocumentExported {
  id           String       @id @default(uuid())
  projectId    String       @map("project_id")
  type         ExportFormat
  fileUrl      String       @map("file_url")
  generatedAt  DateTime     @default(now()) @map("generated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("documents_exported")
}

model Subscription {
  id                     String             @id @default(uuid())
  orgId                  String             @map("org_id")
  plan                   SubscriptionPlan
  status                 SubscriptionStatus @default(trialing)
  currentPeriodEnd       DateTime?          @map("current_period_end")
  seats                  Int                @default(1)
  stripeSubscriptionId   String?            @unique @map("stripe_subscription_id")
  stripePriceId          String?            @map("stripe_price_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("subscriptions")
}

model UsageEvent {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  projectId String?  @map("project_id")
  tokensIn  Int      @map("tokens_in")
  tokensOut Int      @map("tokens_out")
  stage     String
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@map("usage_events")
}

// Un registro por cada vez que se dispara /generate (primera generación o
// "Regenerar paquete completo") — cada una re-ejecuta el pipeline completo
// de Claude y tiene un costo real de tokens, sin importar si el proyecto ya
// contaba para la cuota mensual de "análisis nuevos". Sirve para aplicar un
// tope aparte a las regeneraciones, que de otro modo no tendrían límite.
model GenerationRun {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("generation_runs")
}

// Una conexión = una cuenta de Jira o ClickUp del cliente, conectada con su
// propio token de API (no OAuth — ver nota en integrations/providers). El
// token vive cifrado en reposo (encryptedToken, AES-256-GCM); nunca se
// expone al frontend. targetId/targetLabel es el destino concreto elegido
// dentro de la herramienta (clave de proyecto de Jira o id de lista de
// ClickUp) — sin eso, y sin mappingConfirmed, la conexión no se puede usar
// para enviar nada (ver IntegrationsService.triggerSync).
model IntegrationConnection {
  id                String   @id @default(uuid())
  orgId             String   @map("org_id")
  provider          IntegrationProvider
  label             String
  // Jira: URL base del sitio (https://empresa.atlassian.net). ClickUp: null.
  siteUrl           String?  @map("site_url")
  // Jira: correo asociado al API token, para Basic Auth. ClickUp: null.
  authEmail         String?  @map("auth_email")
  encryptedToken    String   @map("encrypted_token")
  status            IntegrationConnectionStatus @default(active)
  targetId          String?  @map("target_id")
  targetLabel       String?  @map("target_label")
  // "Foto" de la estructura detectada (proyectos/tipos de issue/campos en
  // Jira; espacios/carpetas/listas/campos en ClickUp) — se refresca solo
  // cuando el cliente pide "detectar de nuevo", nunca automáticamente.
  structureSnapshot Json?    @map("structure_snapshot")
  // Mapeo heurístico sugerido tras elegir el destino (tipos de issue para
  // épica/historia/caso de prueba, campo de story points, etc.) — el
  // cliente lo confirma una sola vez; queda fijo hasta que pida re-detectar.
  mapping           Json?
  mappingConfirmed  Boolean  @default(false) @map("mapping_confirmed")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  syncRuns     SyncRun[]

  @@index([orgId])
  @@map("integration_connections")
}

// Un envío (batch) del contenido de un proyecto hacia una conexión —
// registra qué se intentó, qué se creó y qué falló (auditoría, sección 5.6
// del módulo). sourceType solo documenta de dónde vino el contenido; la
// tubería de ejecución es la misma para ambos casos.
model SyncRun {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  connectionId String   @map("connection_id")
  projectId    String   @map("project_id")
  sourceType   SyncSourceType @map("source_type")
  status       SyncStatus @default(in_progress)
  startedAt    DateTime @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  // Error de nivel conexión (ej. token revocado, detectado antes de
  // intentar cualquier ítem) — distinto de los errores por ítem, que viven
  // en SyncItem.errorMessage.
  errorMessage String?  @map("error_message")
  triggeredBy  String   @map("triggered_by")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items        SyncItem[]

  @@index([orgId, startedAt])
  @@index([connectionId])
  @@index([projectId])
  @@map("sync_runs")
}

model SyncItem {
  id           String   @id @default(uuid())
  syncRunId    String   @map("sync_run_id")
  itemType     SyncItemType @map("item_type")
  // Código legible del origen (REQ-001, HU-003, CP-012) — no el uuid interno.
  internalCode String   @map("internal_code")
  internalTitle String  @map("internal_title")
  externalId   String?  @map("external_id")
  externalUrl  String?  @map("external_url")
  status       SyncItemStatus
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  syncRun SyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([syncRunId])
  @@map("sync_items")
}

// --- Módulo QA-AI: automatización de pruebas web de caja negra ----------

enum QaScopeMode {
  scoped // Modo B: un módulo puntual, con su propia ruta de acceso (Fase 0)
  full   // Modo A: exploración completa — reservado para el futuro, no implementado en el MVP
}

enum QaTestCaseStatus {
  draft                 // recién generado por IA, o ya con sus datos resueltos — pendiente de aprobación humana
  blocked_missing_data  // tiene al menos una QaMissingDataRequest sin resolver
  ready                 // aprobado por un humano y sin datos pendientes — se puede ejecutar
  archived
}

enum QaRunStatus {
  in_progress
  passed
  failed
  error // algo impidió correr la prueba (ej. el setup falló) — distinto de "failed", que es un assert que no se cumplió
}

enum QaStepAction {
  goto
  click
  fill
  select
  wait_for_text
  assert_text
  assert_url
  assert_element_visible
}

enum QaMissingDataKind {
  secret   // credencial/contraseña -> va cifrada, nunca en texto plano
  business // un ID, un rango de precio, etc. -> dato de negocio, no secreto
}

enum QaMissingDataStatus {
  pending
  resolved
}

// Un módulo a probar (Fase 0): la URL, el modo, y — si es Modo B — los
// pasos de acceso (login + navegación) que dejan al sistema "en la puerta"
// del módulo real a probar. Ese guion de acceso es la precondición
// reutilizable de la que habla la Fase 0: se ejecuta antes de cada corrida
// de este módulo, y si el flujo de acceso cambia, solo se edita aquí, sin
// tocar nada de otro módulo.
model QaTestModule {
  id          String      @id @default(uuid())
  orgId       String      @map("org_id")
  name        String
  targetUrl   String      @map("target_url")
  scopeMode   QaScopeMode @default(scoped) @map("scope_mode")
  // Qué se quiere probar, en texto libre — es el insumo para que Claude
  // proponga los casos de prueba (Fase 1+2, ver qa-test-cases.stage.ts).
  description String
  // Pasos de acceso al módulo (Fase 0) — array de QaStep, mismo formato que
  // los pasos de un caso de prueba. Vacío en Modo A o si el módulo ya es la
  // primera pantalla (no requiere navegación previa).
  setupSteps  Json        @default("[]") @map("setup_steps")
  // Mapa funcional detectado (Fase 1) — botones, links, campos y
  // encabezados de la página del módulo (Modo B) o de varias páginas
  // alcanzables desde ahí (Modo A). Se refresca solo cuando el cliente
  // pide "Detectar estructura", nunca automáticamente — y es lo que le da
  // a Claude selectores reales en vez de adivinados al generar casos.
  discoveredStructure Json? @map("discovered_structure")
  createdBy   String      @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  testCases    QaTestCase[]
  testRuns     QaTestRun[]

  @@index([orgId])
  @@map("qa_test_modules")
}

model QaTestCase {
  id             String            @id @default(uuid())
  orgId          String            @map("org_id")
  moduleId       String            @map("module_id")
  code           String
  title          String
  severity       TestCaseSeverity  @default(media)
  // Array de QaStep: [{ action, selector?, value?, dataRef? }] — dataRef
  // referencia el fieldKey de una QaMissingDataRequest cuando el valor
  // todavía no se conoce (ver sección 5 del módulo).
  steps          Json              @default("[]")
  expectedResult String            @map("expected_result")
  status         QaTestCaseStatus  @default(draft)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  module              QaTestModule            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  missingDataRequests  QaMissingDataRequest[]
  runItems             QaTestRunItem[]

  @@index([moduleId])
  @@unique([moduleId, code])
  @@map("qa_test_cases")
}

// El mecanismo de solicitud de datos faltantes (sección 5 del módulo): en
// vez de inventar un valor o bloquearse en silencio, cada dato que falta
// queda registrado aquí con su trazabilidad completa. El valor mismo nunca
// se expone en listados — solo el metadato de la solicitud (qué se pidió,
// para qué caso, quién y cuándo respondió).
model QaMissingDataRequest {
  id             String               @id @default(uuid())
  orgId          String               @map("org_id")
  testCaseId     String               @map("test_case_id")
  kind           QaMissingDataKind
  // Clave con la que un paso referencia este dato (steps[].dataRef).
  fieldKey       String               @map("field_key")
  question       String
  format         String
  status         QaMissingDataStatus  @default(pending)
  // Solo uno de los dos se llena, según `kind`. encryptedValue nunca se
  // devuelve al frontend (ver QaService.sanitizeMissingDataRequest).
  encryptedValue String?              @map("encrypted_value")
  businessValue  String?              @map("business_value")
  requestedAt    DateTime             @default(now()) @map("requested_at")
  respondedAt    DateTime?            @map("responded_at")
  respondedBy    String?              @map("responded_by")
  firstUsedRunId String?              @map("first_used_run_id")

  testCase QaTestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@index([orgId, status])
  @@map("qa_missing_data_requests")
}

model QaTestRun {
  id          String      @id @default(uuid())
  orgId       String      @map("org_id")
  moduleId    String      @map("module_id")
  status      QaRunStatus @default(in_progress)
  errorMessage String?    @map("error_message")
  startedAt   DateTime    @default(now()) @map("started_at")
  finishedAt  DateTime?   @map("finished_at")
  triggeredBy String      @map("triggered_by")
  // Nombre del PDF de reporte una vez generado (Fase 4) — mismo patrón de
  // almacenamiento en disco que DocumentExported en el módulo de export.
  reportFile  String?     @map("report_file")

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  module       QaTestModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  items        QaTestRunItem[]

  @@index([orgId, startedAt])
  @@index([moduleId])
  @@map("qa_test_runs")
}

model QaTestRunItem {
  id            String      @id @default(uuid())
  runId         String      @map("run_id")
  testCaseId    String      @map("test_case_id")
  status        QaRunStatus
  errorMessage  String?     @map("error_message")
  // Array de nombres de archivo de capturas (una por paso), guardadas en
  // storage/qa-evidence/{runId}/ — mismo patrón que los documentos exportados.
  screenshots   Json        @default("[]")
  startedAt     DateTime    @default(now()) @map("started_at")
  finishedAt    DateTime?   @map("finished_at")

  run      QaTestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase QaTestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("qa_test_run_items")
}
