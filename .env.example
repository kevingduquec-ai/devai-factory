# Base de datos — DATABASE_URL es el rol dueño de las tablas, solo para
# `prisma migrate` (necesita privilegios de owner para alterar el schema).
# DATABASE_APP_URL es el rol restringido que usa la API en tiempo de
# ejecución — ver migración 20260902032632_app_runtime_role: en Docker,
# el rol de POSTGRES_USER es superusuario, y un superusuario de Postgres
# siempre se salta Row-Level Security sin importar cuántas políticas
# existan. Nunca apuntar PrismaService a DATABASE_URL.
DATABASE_URL=postgresql://devai:devai@localhost:5433/devai_factory
DATABASE_APP_URL=postgresql://devai_app:PMR0800j5_sN_-BShGAH8B8x@localhost:5433/devai_factory

# Redis / colas
REDIS_URL=redis://localhost:6380

# Autenticación
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Facturación (Stripe) — fase de billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# General
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
